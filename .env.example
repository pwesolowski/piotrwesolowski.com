# Contact form provider: leave empty to keep the form inactive (it then points to e-mail).
# Options: resend | formspree
CONTACT_PROVIDER=

# Resend (https://resend.com) — requires a verified sending domain
RESEND_API_KEY=
RESEND_FROM="Strona <formularz@piotrwesolowski.com>"
CONTACT_TO_EMAIL=kontakt@piotrwesolowski.com

# Formspree (https://formspree.io) — form id from the form URL
FORMSPREE_FORM_ID=
